#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Mouse/pointing support is disabled. To restore it, uncomment the block below,
// re-enable CONFIG_ZMK_POINTING in mantaray_pro_wireless_left.conf, and restore the
// commented mouse layers at the end of the keymap node.
// #define ZMK_POINTING_DEFAULT_MOVE_VAL 1600 // default: 600
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 35   // default: 10
// #include <dt-bindings/zmk/pointing.h>
//
// &mmv {
//     time-to-max-speed-ms = <300>;
// };

/ {

    behaviors {
        // Layer-tap tuned so tap-then-hold repeats backspace instead of engaging the layer.
        ltb: layer_tap_backspace {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced"; // thumb keys don't roll with fingers, so resolve the hold on nested taps
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        bt_mac0: bt_mac0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };
        bt_mac1: bt_mac1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 0>;
        };
        bt_mac2: bt_mac2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to 0>;
        };
        bt_mac3: bt_mac3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&to 0>;
        };
        bt_win4: bt_win4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&to 3>;
        };
        copy_local: copy_local {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <50>;
            bindings = <&kp LA(LS(LG(C)))>, <&kp LA(LG(B))>;
        };
        copy_docs: copy_docs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <50>;
            bindings = <&kp LA(LS(LG(C)))>, <&kp LA(LG(G))>;
        };
        cmd_tab: cmd_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp TAB>, <&macro_pause_for_release>, <&macro_release &kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0 - Pine Mac
            display-name = "Pine Mac";
            bindings = <
                &mt LALT GRAVE  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &caps_word &kp Q &kp L &kp C &kp M &kp K   &kp SINGLE_QUOTE &kp F  &kp U     &kp O   &kp Y &kp BACKSLASH
                &mt LSHIFT BACKSPACE &kp N &kp R &kp S &kp T &kp W   &kp P &kp H  &kp E &kp A &kp I &mt RSHIFT SEMICOLON
                &mt LCTRL TAB &kp J  &kp X &kp Z &kp G &kp V   &kp B &kp D  &kp COMMA &kp DOT &kp FSLH &kp ENTER
                &mt LGUI ENTER &mt LSHIFT ESC &ltb 1 BACKSPACE &lt 2 SPACE 
            >;
        };

        nav_layer { // Layer 1
            display-name = "Nav";
            bindings = <
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &kp LA(LG(C)) &kp LC(LA(LEFT)) &kp LC(LA(RET)) &kp LC(LA(C)) &kp LC(LA(RIGHT)) &none   &none &kp LG(LEFT) &kp LA(LEFT) &kp LA(RIGHT) &kp LG(RIGHT) &none
                &kp LSHIFT &cmd_tab &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP   &kp HOME &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp END
                &kp LCTRL &none &none &none &none &none   &kp PG_DN &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &kp PG_UP
                &kp LGUI &kp LSHIFT &trans &trans
            >;
        };

        symbols_layer { // Layer 2
            display-name = "Symbols";
            bindings = <
                &kp ESC  &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F10 &kp F6  &kp F7     &kp F8   &kp F9    &kp F11
                &kp GRAVE &kp EXCLAMATION &kp AT_SIGN &kp HASH &kp DOLLAR &kp PERCENT   &kp KP_DIVIDE &kp KP_N7  &kp KP_N8     &kp KP_N9   &kp KP_N0 &kp F12
                &none &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR   &kp KP_MULTIPLY &kp KP_N4  &kp KP_N5 &kp KP_N6 &kp PLUS &kp BSPC
                &studio_unlock &none  &kp LBKT &kp RBKT &kp LBRC &kp RBRC   &kp EQUAL &kp KP_N1  &kp KP_N2 &kp KP_N3 &kp KP_MINUS &kp ENTER
                &none &none &none &none
            >;
        };

        win_base_layer { // Layer 3 - Pine Win
            display-name = "Pine Win";
            bindings = <
                &mt LALT GRAVE  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &caps_word &kp Q &kp L &kp C &kp M &kp K   &kp SINGLE_QUOTE &kp F  &kp U     &kp O   &kp Y &kp BACKSLASH
                &mt LSHIFT BACKSPACE &kp N &kp R &kp S &kp T &kp W   &kp P &kp H  &kp E &kp A &kp I &mt RSHIFT SEMICOLON
                &mt LGUI TAB &kp J  &kp X &kp Z &kp G &kp V   &kp B &kp D  &kp COMMA &kp DOT &kp FSLH &kp ENTER
                &mt LCTRL ENTER &mt LSHIFT TAB &ltb 4 BACKSPACE &lt 2 SPACE 
            >;
        };

        win_nav_layer { // Layer 4
            display-name = "Win Nav";
            bindings = <
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &kp LG(V) &kp LG(LEFT) &kp LG(UP) &kp LG(DOWN) &kp LG(RIGHT) &none   &none &kp HOME &kp LC(LEFT) &kp LC(RIGHT) &kp END &none
                &kp LSHIFT &kp LA(TAB) &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP   &kp HOME &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp END
                &kp LCTRL &none &kp LG(LS(S)) &none &none &none   &kp PG_DN &kp LG(LC(LEFT)) &kp LG(TAB) &none &kp LG(LC(RIGHT)) &kp PG_UP
                &kp LCTRL &kp LSHIFT &trans &trans
            >;
        };

        hotkey_layer { // Layer 5 - must stay the highest-numbered layer so it always wins over win_base_layer (3)
            display-name = "Hotkeys";
            bindings = <
                &none  &bt_mac0 &bt_mac1 &bt_mac2 &bt_mac3 &bt_win4   &none &none  &none     &none   &none    &none
                &kp LC(N1) &kp LC(N2) &kp LC(N3) &kp LC(LG(O)) &kp LC(LA(LG(O))) &kp LC(LA(LG(P)))   &none &none  &none  &none  &none &none
                &none &kp LC(C) &none &kp LA(LG(V)) &copy_local &copy_docs   &none &none  &none &none &none &none
                &none &none  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(LC(N4))) &kp LG(LS(N5))   &none &none  &none &none &none &none
                &bt BT_PRV &bt BT_NXT &none &none
            >;
        };

        /* Previous mouse layers, kept for reference. Require CONFIG_ZMK_POINTING.
           They live at the end so uncommenting them appends layers 6 and 7 rather than
           shifting the existing indices, which profile_layer_sync.c depends on.
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none &kp LG(F) &kp LG(A) &kp LG(T) &kp LG(LS(T)) &none   &none &kp LEFT &kp DOWN  &kp UP     &kp RIGHT    &none
                &none &kp LG(LEFT) &kp LA(LEFT) &kp LA(RIGHT) &kp LG(RIGHT) &none   &msc SCRL_LEFT &msc SCRL_DOWN  &mmv MOVE_UP  &msc SCRL_UP   &msc SCRL_RIGHT &none
                &kp LA(LG(C)) &kp LG(S) &mkp LCLK &mkp MCLK &mkp RCLK &none   &kp LGUI &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &cmd_tab &kp LG(Z)  &kp LG(X) &kp LG(C) &kp LG(V) &none   &none &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &none
                &none &none &mkp LCLK &mkp RCLK
            >;
        };

        win_mouse_layer {
            display-name = "Win Mouse";
            bindings = <
                &none  &kp LC(F) &kp LC(A) &kp LC(T) &kp LC(LS(T)) &none   &none &kp LEFT &kp DOWN  &kp UP     &kp RIGHT    &none
                &none &kp HOME &kp LC(LEFT) &kp LC(RIGHT) &kp END &none   &msc SCRL_LEFT &msc SCRL_DOWN  &mmv MOVE_UP  &msc SCRL_UP   &msc SCRL_RIGHT &none
                &kp LG(V) &kp LC(S) &mkp LCLK &mkp MCLK &mkp RCLK &none   &kp LCTRL &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &kp LA(TAB) &kp LC(Z)  &kp LC(X) &kp LC(C) &kp LC(V) &none   &none &kp LG(LC(LEFT)) &kp LG(TAB) &none &kp LG(LC(RIGHT)) &none
                &none &none &mkp LCLK &mkp RCLK
            >;
        };
        */

    };

    combos {
        compatible = "zmk,combos";

        combo_media {
            timeout-ms = <50>;
            key-positions = <50 51>; // Both right thumb keys
            bindings = <&mo 5>;
            layers = <0 1 2 3 4 5>;
            slow-release;
        };

        combo_clear_bt {
            timeout-ms = <50>; // The keys must be pressed within 50ms of each other
            key-positions = <13 22>; // Use key positions 13 (Q) and 22 (P)
            bindings = <&bt BT_CLR>;
            layers = <0 1 2 3 4 5>;
            // To make the combo trigger only on hold, uncomment the line below
            require-prior-idle-ms = <200>;
        };
    };
 };

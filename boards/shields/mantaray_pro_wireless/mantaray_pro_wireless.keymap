#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1600 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35   // default: 10
#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <300>;
};

/ {

    macros {
        bt_mac0: bt_mac0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };
        bt_win1: bt_win1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 4>;
        };
        bt_mac2: bt_mac2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to 0>;
        };
        bt_mac3: bt_mac3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&to 0>;
        };
        bt_mac4: bt_mac4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&to 0>;
        };
        copy_local: copy_local {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <50>;
            bindings = <&kp LA(LS(LG(C)))>, <&kp LA(LG(B))>;
        };
        copy_docs: copy_docs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <50>;
            bindings = <&kp LA(LS(LG(C)))>, <&kp LA(LG(G))>;
        };
        cmd_tab: cmd_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp TAB>, <&macro_pause_for_release>, <&macro_release &kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0 - Pine Mac
            display-name = "Pine Mac";
            bindings = <
                &mt KP_EQUAL GRAVE  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &kp CAPS &kp Q &kp L &kp C &kp M &kp K   &kp SINGLE_QUOTE &kp F  &kp U     &kp O   &kp Y &kp BACKSLASH
                &mt LSHIFT BACKSPACE &kp N &kp R &kp S &kp T &kp W   &kp P &kp H  &kp E &kp A &kp I &kp SEMICOLON
                &mt LCTRL TAB &kp J  &kp X &kp Z &kp G &kp V   &kp B &kp D  &kp COMMA &kp DOT &kp FSLH &kp ENTER
                &lt 1 ENTER &mt LSHIFT ESC &kp BACKSPACE &lt 2 SPACE 
            >;
        };

        mouse_layer { // Layer 1
            display-name = "Mouse";
            bindings = <
                &none  &kp LG(LEFT) &kp LA(LEFT) &kp LA(RIGHT) &kp LG(RIGHT) &kp LG(A)   &none &kp LEFT &kp DOWN  &kp UP     &kp RIGHT    &none
                &kp LG(F) &kp LG(LBKT) &cmd_tab &kp LG(GRAVE) &kp LG(RBKT) &none   &msc SCRL_LEFT &msc SCRL_DOWN  &mmv MOVE_UP  &msc SCRL_UP   &msc SCRL_RIGHT &none
                &kp F11 &kp LG(S) &mkp LCLK &mkp MCLK &mkp RCLK &none   &kp LGUI &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &kp LG(LS(T)) &kp LG(Z)  &kp LG(X) &kp LG(C) &kp LG(V) &none   &none &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &none
                &none &none &mkp LCLK &mkp RCLK
            >;
        };

        symbols_layer { // Layer 2
            display-name = "Symbols";
            bindings = <
                &kp ESC  &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F10 &kp F6  &kp F7     &kp F8   &kp F9    &kp F11
                &kp GRAVE &kp EXCLAMATION &kp AT_SIGN &kp HASH &kp DOLLAR &kp PERCENT   &kp KP_DIVIDE &kp KP_N7  &kp KP_N8     &kp KP_N9   &kp KP_N0 &kp F12
                &none &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR   &kp KP_MULTIPLY &kp KP_N4  &kp KP_N5 &kp KP_N6 &kp PLUS &kp BSPC
                &studio_unlock &none  &kp LBKT &kp RBKT &kp LBRC &kp RBRC   &kp EQUAL &kp KP_N1  &kp KP_N2 &kp KP_N3 &kp KP_MINUS &kp ENTER
                &none &none &none &none
            >;
        };

        hotkey_layer { // Layer 3
            display-name = "Hotkeys";
            bindings = <
                &none  &bt_mac0 &bt_win1 &bt_mac2 &bt_mac3 &bt_mac4   &none &none  &none     &none   &none    &none
                &kp LC(N1) &kp LC(N2) &kp LC(N3) &kp LC(LG(O)) &kp LC(LA(LG(O))) &kp LC(LA(LG(P)))   &none &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP &none
                &none &kp LC(C) &kp LA(LG(C)) &kp LA(LG(V)) &copy_local &copy_docs   &kp UP &kp LG(K)  &kp LG(W) &kp LG(T) &kp LG(LS(T)) &kp LG(F)
                &none &none  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(LC(N4))) &kp LG(LS(N5))   &kp DOWN &kp LC(LA(LEFT))  &kp LC(LA(RET)) &kp LC(LA(C)) &kp LC(LA(RIGHT)) &kp LG(S)
                &bt BT_PRV &bt BT_NXT &none &none
            >;
        };

        win_base_layer { // Layer 4 - Pine Win
            display-name = "Pine Win";
            bindings = <
                &mt KP_EQUAL GRAVE  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &kp CAPS &kp Q &kp L &kp C &kp M &kp K   &kp SINGLE_QUOTE &kp F  &kp U     &kp O   &kp Y &kp BACKSLASH
                &mt LSHIFT BACKSPACE &kp N &kp R &kp S &kp T &kp W   &kp P &kp H  &kp E &kp A &kp I &kp SEMICOLON
                &kp LCTRL &kp J  &kp X &kp Z &kp G &kp V   &kp B &kp D  &kp COMMA &kp DOT &kp FSLH &kp ENTER
                &lt 5 ENTER &mt LSHIFT TAB &kp BACKSPACE &lt 2 SPACE 
            >;
        };

        win_mouse_layer { // Layer 5
            display-name = "Win Mouse";
            bindings = <
                &none  &kp HOME &kp LC(LEFT) &kp LC(RIGHT) &kp END &kp LC(A)   &none &kp LEFT &kp DOWN  &kp UP     &kp RIGHT    &none
                &none &kp LA(LEFT) &kp LA(TAB) &none &kp LA(RIGHT) &none   &msc SCRL_LEFT &msc SCRL_DOWN  &mmv MOVE_UP  &msc SCRL_UP   &msc SCRL_RIGHT &none
                &kp LG(D) &kp LC(S) &mkp LCLK &mkp MCLK &mkp RCLK &none   &kp LCTRL &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &none &none  &kp LC(X) &kp LC(C) &kp LC(V) &none   &none &kp LG(LC(LEFT)) &kp LG(TAB) &none &kp LG(LC(RIGHT)) &none
                &none &none &mkp LCLK &mkp RCLK
            >;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_media {
            timeout-ms = <50>;
            key-positions = <50 51>; // Both right thumb keys
            bindings = <&mo 3>;
        };

        combo_clear_bt {
            timeout-ms = <50>; // The keys must be pressed within 50ms of each other
            key-positions = <13 22>; // Use key positions 13 (Q) and 22 (P)
            bindings = <&bt BT_CLR>;
            // To make the combo trigger only on hold, uncomment the line below
            require-prior-idle-ms = <200>;
        };
    };
 };

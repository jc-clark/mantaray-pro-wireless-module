#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {

    macros {
        bt_mac0: bt_mac0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };
        bt_win1: bt_win1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 4>;
        };
        bt_mac2: bt_mac2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to 0>;
        };
        bt_mac3: bt_mac3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&to 0>;
        };
        bt_mac4: bt_mac4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&to 0>;
        };
        copy_local: copy_local {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <50>;
            bindings = <&kp LA(LS(LG(C)))>, <&kp LA(LG(B))>;
        };
        copy_docs: copy_docs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <500>;
            tap-ms = <50>;
            bindings = <&kp LA(LS(LG(C)))>, <&kp LA(LG(G))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &mt KP_EQUAL GRAVE  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &kp CAPS &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P &kp BACKSLASH
                &mt LSHIFT BACKSPACE &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K &kp L &kp SEMICOLON &mt RSHFT SINGLE_QUOTE
                &mt LCTRL TAB &mt LALT Z  &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &mt RCTRL FSLH &kp ENTER
                &lt 1 ENTER &mt LGUI ESC &mt LSHIFT BACKSPACE &lt 2 SPACE 
            >;
        };

        hotkey_layer { // Layer 1
            display-name = "Hotkeys";
            bindings = <
                &none  &none &none &none &none &none   &none &msc SCRL_LEFT &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT    &none
                &none &none &none &kp LC(LG(O)) &kp LC(LA(LG(P))) &none   &none &mkp LCLK  &mmv MOVE_UP  &mkp RCLK   &none &none
                &none &none &mkp LCLK &mkp MCLK &mkp RCLK &none   &none &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &none &kp LC(C)  &kp LA(LG(C)) &kp LA(LG(V)) &copy_local &copy_docs   &none &mkp MCLK  &none &none &none &none
                &none &none &kp DOWN &kp UP
            >;
        };

        symbols_layer { // Layer 2
            display-name = "Symbols";
            bindings = <
                &kp ESC  &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F6 &kp F7  &kp F8     &kp F9   &kp F10    &kp F11
                &kp GRAVE &kp EXCLAMATION &kp AT_SIGN &kp HASH &kp DOLLAR &kp PERCENT   &kp KP_N7 &kp KP_N8  &kp KP_N9     &kp KP_MINUS   &kp KP_DIVIDE &kp F12
                &none &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR   &kp KP_N4 &kp KP_N5  &kp KP_N6 &kp PLUS &kp KP_MULTIPLY &kp BSPC
                &studio_unlock &none  &kp LBKT &kp RBKT &kp LBRC &kp RBRC   &kp KP_N1 &kp KP_N2  &kp KP_N3 &kp DOT &kp EQUAL &kp ENTER
                &none &none &none &kp KP_N0
            >;
        };

        media_layer { // Layer 3
            display-name = "Media";
            bindings = <
                &none  &bt_mac0 &bt_win1 &bt_mac2 &bt_mac3 &bt_mac4   &out OUT_USB &out OUT_BLE  &none     &none   &none    &none
                &none &none &none &none &none &none   &none &none  &none     &none   &none &none
                &kp LC(LA(LG(N1))) &kp LC(LA(LG(N2))) &kp LC(LA(LG(N3))) &kp LC(LA(LG(N4))) &kp LC(LA(LG(N5))) &none   &none &kp LC(LEFT)  &none &kp LC(RIGHT) &none &none
                &none &none  &none &none &none &none   &none &none  &none &none &none &none
                &bt BT_PRV &bt BT_NXT &none &none
            >;
        };

        win_base_layer { // Layer 4
            display-name = "Win Base";
            bindings = <
                &mt KP_EQUAL ESC  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &kp CAPS &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P &kp BACKSLASH
                &mt LSHIFT BACKSPACE &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K &kp L &kp SEMICOLON &mt RSHFT SINGLE_QUOTE
                &kp LCTRL &mt LALT Z  &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &mt RCTRL FSLH &kp ENTER
                &lt 5 ENTER &mt LGUI TAB &mt LSHIFT BACKSPACE &lt 2 SPACE 
            >;
        };

        win_hotkey_layer { // Layer 5
            display-name = "Win Hotkeys";
            bindings = <
                &none  &none &none &none &none &none   &msc SCRL_LEFT &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT   &none    &none
                &none &none &none &none &none &none   &none &mkp LCLK  &mmv MOVE_UP     &mkp RCLK   &none &none
                &none &none &none &none &none &none   &none &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
                &none &none  &none &none &none &none   &none &mkp MCLK  &none &none &none &none
                &none &none &none &none
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_media {
            timeout-ms = <50>;
            key-positions = <50 51>; // Both right thumb keys
            bindings = <&mo 3>;
        };

        combo_clear_bt {
            timeout-ms = <50>; // The keys must be pressed within 50ms of each other
            key-positions = <13 22>; // Use key positions 13 (Q) and 22 (P)
            bindings = <&bt BT_CLR>;
            // To make the combo trigger only on hold, uncomment the line below
            require-prior-idle-ms = <200>;
        };
    };
 };
